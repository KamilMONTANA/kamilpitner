---
import { siteConfig } from "../data/siteConfig";
---

<section id="faq" class="py-20 md:py-32 bg-[#fcfbfa] border-b border-[#e7e5e4]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-100 text-zinc-900 text-xs font-bold uppercase tracking-wider mb-4 border border-zinc-200">
        <span>Odpowiedzi na pytania</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-zinc-950 tracking-tight leading-tight mb-4">
        Najczęściej zadawane pytania.
      </h2>
      <p class="text-lg text-zinc-600 font-normal leading-relaxed">
        Masz inne wątpliwości? Zadzwoń do mnie bezpośrednio – odpowiem na każde pytanie.
      </p>
    </div>

    <!-- FAQ Accordion List using semantic details/summary -->
    <div class="space-y-4">
      {siteConfig.faq.map((item, index) => (
        <details class="group rounded-2xl border border-zinc-200 bg-white p-6 transition-all duration-200 hover:border-zinc-400 [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-bold text-lg sm:text-xl text-zinc-950 select-none">
            <span class="flex items-center gap-3">
              <span class="text-xs text-zinc-400 font-semibold tabular-nums">0{index + 1}.</span>
              <span>{item.question}</span>
            </span>
            <span class="w-8 h-8 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform group-hover:bg-[#ccff00] group-hover:text-zinc-950">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-zinc-100 text-zinc-600 text-base leading-relaxed pl-7">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <!-- Callout Box -->
    <div class="mt-12 text-center p-8 rounded-3xl bg-zinc-50 border border-zinc-200">
      <h3 class="text-lg font-bold text-zinc-950 mb-2">Nie znalazłeś odpowiedzi na swoje pytanie?</h3>
      <p class="text-sm text-zinc-600 mb-6">Chętnie wyjaśnię wszystkie szczegóły podczas 10-minutowej rozmowy.</p>
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-zinc-950 text-white text-sm font-bold shadow-md hover:bg-zinc-800 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Zadzwoń i zapytaj o szczegóły</span>
      </a>
    </div>
  </div>
</section>
