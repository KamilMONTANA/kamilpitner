---
import { siteConfig } from "../data/siteConfig";
---

<header class="sticky top-0 z-40 w-full border-b border-[#e7e5e4] bg-[#fcfbfa]/90 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-3 text-zinc-950 focus:outline-none" aria-label="Kamil Pitner - Strona główna">
      <img
        src="/logo-KP.png"
        alt="Kamil Pitner Logo"
        class="h-10 w-auto object-contain group-hover:scale-105 transition-transform"
        width="40"
        height="40"
      />
    </a>

    <!-- Desktop Navigation Links (Minimum 16px / text-base) -->
    <nav class="hidden md:flex items-center gap-8 text-base font-semibold text-zinc-700">
      <!-- Dropdown Usługi -->
      <div class="relative group py-2">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 hover:text-zinc-950 transition-colors py-1 cursor-pointer font-semibold text-base focus:outline-none"
          id="services-menu-trigger"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Usługi</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 group-hover:text-zinc-950 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Card -->
        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 z-50 w-80">
          <div class="p-2.5 rounded-2xl bg-white border border-[#e7e5e4] shadow-xl space-y-1">
            <a
              href="/strony-www"
              class="flex items-start gap-3 p-3 rounded-xl hover:bg-zinc-50 transition-colors group/item"
            >
              <div class="w-9 h-9 rounded-xl bg-[#fae8e8] text-blue-700 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" />
                  <line x1="8" y1="21" x2="16" y2="21" />
                  <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
              </div>
              <div>
                <div class="text-base font-bold text-zinc-900 group-hover/item:text-black">Strony WWW</div>
                <div class="text-xs text-zinc-500 leading-tight">Szybkie, konwertujące pod telefon</div>
              </div>
            </a>

            <a
              href="/google-ads"
              class="flex items-start gap-3 p-3 rounded-xl hover:bg-zinc-50 transition-colors group/item"
            >
              <div class="w-9 h-9 rounded-xl bg-[#e0f2fe] text-sky-700 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              </div>
              <div>
                <div class="text-base font-bold text-zinc-900 group-hover/item:text-black">Google Ads</div>
                <div class="text-xs text-zinc-500 leading-tight">Telefony i zlecenia od ręki</div>
              </div>
            </a>

            <a
              href="/google-moja-firma"
              class="flex items-start gap-3 p-3 rounded-xl hover:bg-zinc-50 transition-colors group/item"
            >
              <div class="w-9 h-9 rounded-xl bg-[#eff5ec] text-emerald-700 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <div class="text-base font-bold text-zinc-900 group-hover/item:text-black">Google Moja Firma</div>
                <div class="text-xs text-zinc-500 leading-tight">Top 3 w Mapach Twojego miasta</div>
              </div>
            </a>

            <a
              href="/opinie-nfc"
              class="flex items-start gap-3 p-3 rounded-xl hover:bg-zinc-50 transition-colors group/item"
            >
              <div class="w-9 h-9 rounded-xl bg-[#fef4db] text-amber-700 flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
              </div>
              <div>
                <div class="text-base font-bold text-zinc-900 group-hover/item:text-black">Zbieranie Opinii (NFC)</div>
                <div class="text-xs text-zinc-500 leading-tight">Karty zbliżeniowe i recenzje 5★</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <a href="/#dlaczego-ja" class="hover:text-zinc-950 transition-colors py-1">Dlaczego ja</a>
      <a href="/blog" class="hover:text-zinc-950 transition-colors py-1">Blog</a>
      <a href="/#faq" class="hover:text-zinc-950 transition-colors py-1">FAQ</a>
      <a href="/#kontakt" class="hover:text-zinc-950 transition-colors py-1">Kontakt</a>
    </nav>

    <!-- Header CTA: Direct Call Button (16px / text-base) -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="hidden sm:inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-zinc-950 text-white text-base font-bold shadow-md hover:bg-zinc-800 transition-all border border-zinc-900 group btn-tactile"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#ccff00] group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{siteConfig.phone}</span>
      </a>

      <!-- Copy Number Icon Button -->
      <button
        type="button"
        data-copy-phone={siteConfig.phone}
        title="Skopiuj numer telefonu"
        class="hidden sm:inline-flex p-2.5 rounded-xl border border-zinc-200 text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 hover:border-zinc-300 transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </button>

      <!-- Mobile quick call icon -->
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="sm:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl bg-zinc-950 text-[#ccff00] shadow-sm"
        aria-label="Zadzwoń do mnie"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2.5 rounded-xl border border-zinc-200 text-zinc-700 hover:bg-zinc-100 transition-colors cursor-pointer"
        aria-label="Otwórz menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <div class="py-2 border-b border-zinc-100">
      <div class="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2.5">Usługi</div>
      <div class="pl-2 space-y-2.5">
        <a href="/strony-www" class="block py-1 text-base font-bold text-zinc-900 hover:text-black">Strony WWW</a>
        <a href="/google-ads" class="block py-1 text-base font-bold text-zinc-900 hover:text-black">Google Ads</a>
        <a href="/google-moja-firma" class="block py-1 text-base font-bold text-zinc-900 hover:text-black">Google Moja Firma</a>
        <a href="/opinie-nfc" class="block py-1 text-base font-bold text-zinc-900 hover:text-black">Zbieranie Opinii (NFC)</a>
      </div>
    </div>
    <a href="/#dlaczego-ja" class="block py-2 text-lg font-semibold text-zinc-800 hover:text-zinc-950">Dlaczego ja</a>
    <a href="/blog" class="block py-2 text-lg font-semibold text-zinc-800 hover:text-zinc-950">Blog</a>
    <a href="/#faq" class="block py-2 text-lg font-semibold text-zinc-800 hover:text-zinc-950">FAQ</a>
    <a href="/#kontakt" class="block py-2 text-lg font-semibold text-zinc-800 hover:text-zinc-950">Kontakt</a>
    <div class="pt-3 border-t border-zinc-100">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="w-full flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-zinc-950 text-white font-bold text-center text-base shadow-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Zadzwoń: {siteConfig.phone}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  if (menuBtn && menu) {
    menuBtn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    const links = menu.querySelectorAll("a");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
      });
    });
  }
</script>
