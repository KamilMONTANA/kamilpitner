---
import { siteConfig } from "../data/siteConfig";
import NfcCard3D from "./NfcCard3D.astro";
const { reviewsAutomation } = siteConfig;
---

<section id="opinie-nfc" class="py-20 md:py-28 bg-[#fef4db]/60 border-b border-[#fde6b3] relative overflow-hidden">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 2-Column Clean Hero: 3D Card on Left (50%) | Key Editorial on Right (50%) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: 3D NFC Card directly on page background (50% equal width) -->
      <div class="flex items-center justify-center reveal-on-scroll order-2 lg:order-1">
        <NfcCard3D className="w-full" />
      </div>

      <!-- Right Column: Concise Key Information (50% equal width) -->
      <div class="space-y-6 reveal-on-scroll delay-100 order-1 lg:order-2">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight leading-[1.12]">
          Pozyskuj 5★ opinie jednym zbliżeniem telefonu.
        </h2>

        <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed">
          Klient przykłada smartfon, a formularz recenzji otwiera się w 5 sekund — bez szukania firmy i bez instalowania aplikacji.
        </p>

        <!-- 3 Scannable Key Value Bullets -->
        <div class="space-y-3 pt-1">
          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
              ✓
            </div>
            <p class="text-sm text-zinc-700 leading-snug">
              <strong class="text-zinc-950 font-semibold">Syndykacja opinii:</strong> 
              Łączymy proces tak, aby jedna opinia trafiała jednocześnie w Google, Booksy, ZnanyLekarz i portale branżowe.
            </p>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
              ✓
            </div>
            <p class="text-sm text-zinc-700 leading-snug">
              <strong class="text-zinc-950 font-semibold">Zero oporu dla klienta:</strong> 
              1 dotknięcie zamiast 5 żmudnych kroków ręcznego wyszukiwania profilu. 9 na 10 osób chętnie wystawia ocenę na miejscu.
            </p>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
              ✓
            </div>
            <p class="text-sm text-zinc-700 leading-snug">
              <strong class="text-zinc-950 font-semibold">100% kompatybilności:</strong> 
              Działa natychmiast ze wszystkimi smartfonami iPhone i Android (chip zbliżeniowy NFC + zapasowy kod QR).
            </p>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="/opinie-nfc"
            class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-zinc-900 hover:text-black group underline underline-offset-4 decoration-zinc-400 hover:decoration-zinc-950 transition-colors"
          >
            <span>Zobacz pełną specyfikację kart NFC i cennik zestawów</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
