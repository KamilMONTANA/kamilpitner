    subtitle: "Nowi Klienci od Zaraz",
    bgClass: "bg-[#e0f2fe] border-[#cbe4f9]",
    pedestalHex: "#cde4f7",
    cardIndex: 1,
    iconData: {
      type: "multi",
      viewBox: { x: 0, y: -13, width: 256, height: 256 },
      // Authentic official Google Ads multi-colored vector logo
      layers: [
        {
          path: "M5.888,166.405103 L90.88,20.9 C101.676138,27.2558621 156.115862,57.3844138 164.908138,63.1135172 L79.9161379,208.627448 C70.6206897,220.906621 -5.888,185.040138 5.888,166.396276 L5.888,166.405103 Z",
          color: "#FBBC04"
        },
        {
          path: "M250.084224,166.401789 L165.092224,20.9055131 C153.210293,1.13172 127.619121,-6.05393517 106.600638,5.62496138 C85.582155,17.3038579 79.182155,42.4624786 91.0640861,63.1190303 L176.056086,208.632961 C187.938017,228.397927 213.52919,235.583582 234.547672,223.904686 C254.648086,212.225789 261.966155,186.175582 250.084224,166.419444 L250.084224,166.401789 Z",
          color: "#4285F4"
        },
        {
          type: "ellipse",
          cx: 42.6637241,
          cy: 187.924414,
          rx: 42.6637241,
          ry: 41.6044138,
          color: "#34A853"
        }
      ],
      isDark: false,
    }
  },
  {
    id: "google-moja-firma",
    href: "#google-moja-firma",
    title: "Google Moja Firma",
    subtitle: "Bądź nr 1 w Swoim Mieście",
    bgClass: "bg-[#eff5ec] border-[#dbe8d6]",
    pedestalHex: "#d5e6d4",
    cardIndex: 2,
    iconData: {
      type: "single",
      viewBox: { x: 0, y: 0, width: 24, height: 24 },
      // Official Google My Business (Google Moja Firma) Storefront Awning with Google G
      path: "M3.273 1.636c-.736 0-1.363.492-1.568 1.16L0 9.272c0 1.664 1.336 3 3 3a3 3 0 0 0 3-3c0 1.664 1.336 3 3 3a3 3 0 0 0 3-3c0 1.65 1.35 3 3 3 1.664 0 3-1.336 3-3 0 1.664 1.336 3 3 3s3-1.336 3-3l-1.705-6.476a1.646 1.646 0 0 0-1.568-1.16zm8.729 9.326c-.604 1.063-1.703 1.81-3.002 1.81-1.304 0-2.398-.747-3-1.806-.604 1.06-1.702 1.806-3 1.806-.484 0-.944-.1-1.363-.277v8.232c0 .9.736 1.637 1.636 1.637h17.454c.9 0 1.636-.737 1.636-1.637v-8.232a3.48 3.48 0 0 1-1.363.277c-1.304 0-2.398-.746-3-1.804-.602 1.058-1.696 1.804-3 1.804-1.299 0-2.394-.75-2.998-1.81zm5.725 3.765c.808 0 1.488.298 2.007.782l-.859.859a1.623 1.623 0 0 0-1.148-.447c-.98 0-1.772.827-1.772 1.806 0 .98.792 1.807 1.772 1.807.882 0 1.485-.501 1.615-1.191h-1.615v-1.16h2.826c.035.196.054.4.054.613 0 1.714-1.147 2.931-2.88 2.931a3 3 0 0 1 0-6z",
      brandColor: "#1A73E8",
