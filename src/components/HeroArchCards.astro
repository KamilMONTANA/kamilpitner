/**
 * HeroArchCards.astro
 * 4 Cathedral Arch Cards inspired by the reference layout:
 * - Rounded-t-full vaulted dome arch tops
 * - Pastel tinted backgrounds matching the 4 core services
 * - 3D circular display pedestals with floating, tactile brand emblems
 * - 100% official vector icons from simple-icons (no custom-drawn shapes, no Astro)
 * - Cohesive Plus Jakarta Sans typography
 * - Interactive mouse parallax & 60fps smooth idle levitation
 */
const cards = [
  {
    id: "strony-www",
    href: "#strony-www",
    title: "Strony WWW",
    subtitle: "Szybkie & Skuteczne",
    bgClass: "bg-[#fae8e8] border-[#f5d0d4]",
    pedestalHex: "#ebd0d4",
    cardIndex: 0,
    iconData: {
      type: "single",
      viewBox: { x: 0, y: 0, width: 24, height: 24 },
      // Clean universal browser window vector (no Cloudflare, no Astro, no tech stack)
      path: "M3 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H3zm0 2h18v3H3V5zm0 5h18v9H3v-9zm2-3.5a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm2.5 0a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm2.5 0a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zM5 12h6v5H5v-5zm8 0h6v2h-6v-2zm0 3h6v2h-6v-2z",
