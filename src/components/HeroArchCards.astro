  {
    id: "opinie",
    href: "#opinie-nfc",
    title: "Opinie",
    subtitle: "Zbieraj Oceny w 5 Sekund",
    bgClass: "bg-[#fef4db] border-[#fde6b3]",
    pedestalHex: "#f5e3be",
    cardIndex: 3,
    iconData: {
      type: "single",
      viewBox: { x: 0, y: 0, width: 24, height: 24 },
      // Classic 5-star customer review rating star
      path: "M12 1.75l2.924 5.925 6.538.95-4.731 4.611 1.117 6.514L12 16.674l-5.848 3.076 1.117-6.514-4.731-4.611 6.538-.95L12 1.75z",
