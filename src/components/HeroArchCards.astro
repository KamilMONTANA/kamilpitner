---

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 sm:mt-16">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 items-end">
    {cards.map((card) => (
      <a
        href={card.href}
        class={`arch-card group relative flex flex-col justify-between overflow-hidden rounded-t-full rounded-b-none ${card.bgClass} border border-b-0 px-5 sm:px-6 pt-10 sm:pt-12 pb-0 min-h-[420px] sm:min-h-[460px] lg:min-h-[490px] transition-colors duration-300 select-none block cursor-pointer`}
        data-card-index={card.cardIndex}
        data-pedestal-hex={card.pedestalHex}
        data-icon-json={JSON.stringify(card.iconData)}
      >
        <!-- Top Typography: Title & Subtitle inside Arch Dome (lifts on hover) -->
        <div class="text-center space-y-1 relative z-10 pt-2 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-1.5">
          <h3 class="text-lg sm:text-xl font-extrabold tracking-tight text-zinc-950 group-hover:text-black transition-colors">
            {card.title}
          </h3>
          <p class="text-xs sm:text-sm font-medium text-zinc-600">
            {card.subtitle}
          </p>
        </div>

        <!-- 3D Pedestal & Logo Stage (lifts on hover) -->
        <div class="relative w-full h-64 sm:h-72 lg:h-76 flex items-center justify-center mt-2 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-2">
          <canvas
            class="arch-canvas w-full h-full block pointer-events-none"
          ></canvas>
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  import * as THREE from "three";

  function initArchScenes() {
    const cardElements = document.querySelectorAll(".arch-card");
    if (!cardElements.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Helper: Create soft radial contact shadow texture
    function createShadowTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 256;
      canvas.height = 256;
      const ctx = canvas.getContext("2d");
      if (!ctx) return null;

      const grad = ctx.createRadialGradient(128, 128, 0, 128, 128, 120);
      grad.addColorStop(0, "rgba(0, 0, 0, 0.38)");
      grad.addColorStop(0.4, "rgba(0, 0, 0, 0.16)");
      grad.addColorStop(0.8, "rgba(0, 0, 0, 0.04)");
      grad.addColorStop(1, "rgba(0, 0, 0, 0)");

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(128, 128, 128, 0, Math.PI * 2);
      ctx.fill();

      const tex = new THREE.CanvasTexture(canvas);
      tex.needsUpdate = true;
      return tex;
    }

    const shadowTexture = createShadowTexture();

    // Helper: Draw crisp official vector logos directly with pixel-perfect scale and positioning
    function createLogoTexture(config: any) {
      const canvas = document.createElement("canvas");
      canvas.width = 1024;
      canvas.height = 1024;
      const ctx = canvas.getContext("2d");
      if (!ctx) return null;

      const isDark = !!config.isDark;

      // 1. Badge Face Background (Clean porcelain or sleek obsidian)
      if (isDark) {
        const bgGrad = ctx.createLinearGradient(0, 0, 1024, 1024);
        bgGrad.addColorStop(0, "#14151d");
        bgGrad.addColorStop(1, "#0a0a0e");
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, 1024, 1024);

        // Soft inner rim aligned with squircle
        ctx.strokeStyle = "rgba(255, 255, 255, 0.12)";
        ctx.lineWidth = 16;
        ctx.beginPath();
        ctx.roundRect(48, 48, 928, 928, 200);
        ctx.stroke();
      } else {
        const bgGrad = ctx.createLinearGradient(0, 0, 1024, 1024);
        bgGrad.addColorStop(0, "#ffffff");
        bgGrad.addColorStop(0.6, "#fafafa");
        bgGrad.addColorStop(1, "#f4f4f5");
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, 1024, 1024);

        // Soft inner rim aligned with squircle
        ctx.strokeStyle = "rgba(0, 0, 0, 0.05)";
        ctx.lineWidth = 16;
        ctx.beginPath();
        ctx.roundRect(48, 48, 928, 928, 200);
        ctx.stroke();
      }

      // 2. Render Icon based on type (single path or multi-colored layers)
      const targetSize = 560; // target pixel size inside 1024x1024 badge
      const vb = config.viewBox || { x: 0, y: 0, width: 24, height: 24 };
      const scale = targetSize / Math.max(vb.width, vb.height);
      const scaledW = vb.width * scale;
      const scaledH = vb.height * scale;
      const offsetX = (1024 - scaledW) / 2 - vb.x * scale;
      const offsetY = (1024 - scaledH) / 2 - vb.y * scale;

      ctx.save();
      ctx.translate(offsetX, offsetY);
      ctx.scale(scale, scale);

      if (config.type === "multi" && Array.isArray(config.layers)) {
        config.layers.forEach((layer: any) => {
          if (layer.path) {
            const p = new Path2D(layer.path);
            ctx.fillStyle = layer.color;
            ctx.fill(p);
          } else if (layer.type === "ellipse") {
            ctx.fillStyle = layer.color;
            ctx.beginPath();
            ctx.ellipse(layer.cx, layer.cy, layer.rx, layer.ry, 0, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      } else if (config.path) {
        const p = new Path2D(config.path);
        ctx.fillStyle = config.brandColor || "#18181b";
        ctx.fill(p);
      }

      ctx.restore();

      const texture = new THREE.CanvasTexture(canvas);
      texture.anisotropy = 16;
      texture.needsUpdate = true;
      return texture;
    }

    // Helper: Create Squircle shape
    function createSquircleShape(size: number, radius: number) {
      const shape = new THREE.Shape();
      const x = -size / 2;
      const y = -size / 2;
      const w = size;
      const h = size;
      const r = radius;

      shape.moveTo(x + r, y);
      shape.lineTo(x + w - r, y);
      shape.quadraticCurveTo(x + w, y, x + w, y + r);
      shape.lineTo(x + w, y + h - r);
      shape.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      shape.lineTo(x + r, y + h);
      shape.quadraticCurveTo(x, y + h, x, y + h - r);
      shape.lineTo(x, y + r);
      shape.quadraticCurveTo(x, y, x + r, y);

      return shape;
    }

    const instances: Array<{
      renderer: THREE.WebGLRenderer;
      scene: THREE.Scene;
      camera: THREE.PerspectiveCamera;
      badgeGroup: THREE.Group;
      pedestalMesh: THREE.Mesh;
      pedestalShadow: THREE.Mesh;
      badgeShadow: THREE.Mesh;
      targetRotX: number;
      targetRotY: number;
      cardIndex: number;
    }> = [];

    // Shared geometry for the squircle badge
    const squircleShape = createSquircleShape(1.68, 0.38);
    const squircleGeom = new THREE.ExtrudeGeometry(squircleShape, {
      depth: 0.14,
      bevelEnabled: true,
      bevelThickness: 0.035,
      bevelSize: 0.035,
      bevelSegments: 4,
    });
    squircleGeom.center();

    // Normalize UV coordinates on squircleGeom so the 1024x1024 texture displays crisply on the front face
    squircleGeom.computeBoundingBox();
    const bb = squircleGeom.boundingBox!;
    const sizeX = bb.max.x - bb.min.x;
    const sizeY = bb.max.y - bb.min.y;
    const uvAttr = squircleGeom.attributes.uv;
    for (let i = 0; i < uvAttr.count; i++) {
      const u = (squircleGeom.attributes.position.getX(i) - bb.min.x) / sizeX;
      const v = (squircleGeom.attributes.position.getY(i) - bb.min.y) / sizeY;
      uvAttr.setXY(i, u, v);
    }
    uvAttr.needsUpdate = true;

    // Shared geometry for pedestal and shadows
    const pedestalGeom = new THREE.CylinderGeometry(1.38, 1.48, 0.24, 64);
    const shadowGeom = new THREE.PlaneGeometry(3.4, 3.4);
    const badgeShadowGeom = new THREE.PlaneGeometry(1.6, 0.75);

    cardElements.forEach((cardEl, idx) => {
      const canvas = cardEl.querySelector(".arch-canvas") as HTMLCanvasElement;
      if (!canvas) return;

      const iconJson = JSON.parse(cardEl.getAttribute("data-icon-json") || "{}");
      const pedestalHex = cardEl.getAttribute("data-pedestal-hex") || "#e5e7eb";

      // Three.js Scene Setup
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
      camera.position.set(0, 1.05, 4.7);
      camera.lookAt(0, 0.3, 0);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 1.5);
      scene.add(ambientLight);

      const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
      keyLight.position.set(-2.5, 5, 4.5);
      scene.add(keyLight);

      const fillLight = new THREE.DirectionalLight(0xfff7ed, 1.0);
      fillLight.position.set(3, 2, 2.5);
      scene.add(fillLight);

      // Contact shadow beneath the pedestal
      const pedestalShadowMat = new THREE.MeshBasicMaterial({
        map: shadowTexture,
        transparent: true,
        opacity: 0.65,
        depthWrite: false,
      });
      const pedestalShadow = new THREE.Mesh(shadowGeom, pedestalShadowMat);
      pedestalShadow.rotation.x = -Math.PI / 2;
      pedestalShadow.position.set(0, -0.48, 0);
      scene.add(pedestalShadow);

      // The 3D Pedestal Cylinder
      const pedestalColorNum = parseInt(pedestalHex.replace("#", "0x"), 16);
      const pedestalMat = new THREE.MeshStandardMaterial({
        color: pedestalColorNum,
        roughness: 0.7,
        metalness: 0.05,
      });
      const pedestalMesh = new THREE.Mesh(pedestalGeom, pedestalMat);
      pedestalMesh.position.set(0, -0.36, 0);
      scene.add(pedestalMesh);

      // The Logo Badge Group
      const badgeGroup = new THREE.Group();
      badgeGroup.position.set(0, 0.66, 0);
      scene.add(badgeGroup);

      // Badge Material with decal textures
      const logoTexture = createLogoTexture(iconJson);
      const isDark = !!iconJson.isDark;

      // In Three.js ExtrudeGeometry:
      // materialIndex 0 = Front & Back faces (receives logoTexture)
      // materialIndex 1 = Sides & Bevel edges (clean solid metallic/matte edge)
      const faceMaterial = new THREE.MeshStandardMaterial({
        map: logoTexture,
        roughness: isDark ? 0.3 : 0.2,
        metalness: isDark ? 0.25 : 0.08,
      });

      const edgeMaterial = new THREE.MeshStandardMaterial({
        color: isDark ? 0x18181b : 0xf4f4f5,
        roughness: isDark ? 0.35 : 0.25,
        metalness: isDark ? 0.45 : 0.15,
      });

      const badgeMaterials = [faceMaterial, edgeMaterial];
      const badgeMesh = new THREE.Mesh(squircleGeom, badgeMaterials);
      badgeGroup.add(badgeMesh);

      // Small dynamic shadow cast on top of the pedestal
      const badgeShadowMat = new THREE.MeshBasicMaterial({
        map: shadowTexture,
        transparent: true,
        opacity: 0.45,
        depthWrite: false,
      });
      const badgeShadow = new THREE.Mesh(badgeShadowGeom, badgeShadowMat);
      badgeShadow.rotation.x = -Math.PI / 2;
      badgeShadow.position.set(0, -0.23, 0);
      scene.add(badgeShadow);

      // Interaction State
      const instance = {
        renderer,
        scene,
        camera,
        badgeGroup,
        pedestalMesh,
        pedestalShadow,
        badgeShadow,
        targetRotX: 0,
        targetRotY: 0,
        targetLift: 0,
        lift: 0,
        cardIndex: idx,
      };

      instances.push(instance);

      // Mouse Parallax & Hover Elevation handlers on the Card
      (cardEl as HTMLElement).addEventListener("pointerenter", () => {
        instance.targetLift = 0.14;
      });

      (cardEl as HTMLElement).addEventListener("pointermove", (e: PointerEvent) => {
        const rect = (cardEl as HTMLElement).getBoundingClientRect();
        const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const normY = ((e.clientY - rect.top) / rect.height) * 2 - 1;

        instance.targetRotY = normX * 0.38;
        instance.targetRotX = -normY * 0.28;
        instance.targetLift = 0.14;
      });

      (cardEl as HTMLElement).addEventListener("pointerleave", () => {
        instance.targetRotX = 0;
        instance.targetRotY = 0;
        instance.targetLift = 0;
      });
    });

    // Handle Resize
    window.addEventListener("resize", () => {
      instances.forEach(({ renderer, camera }) => {
        const canvas = renderer.domElement;
        camera.aspect = canvas.clientWidth / canvas.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
      });
    });

    // Pause RAF when Hero is out of viewport to save 100% GPU
    let isVisible = true;
    const heroSection = document.getElementById("hero");
    if (heroSection) {
      const observer = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
      }, { threshold: 0.05 });
      observer.observe(heroSection);
    }

    // Animation Loop
    let startTime = performance.now();

    function animate() {
      requestAnimationFrame(animate);
      if (!isVisible) return;

      const elapsed = (performance.now() - startTime) * 0.001;

      instances.forEach((inst) => {
        // Idle floating bobbing + interactive hover lift
        if (!prefersReducedMotion) {
          inst.lift += (inst.targetLift - inst.lift) * 0.05;
          const floatOffset = Math.sin(elapsed * 1.8 + inst.cardIndex * 1.3) * 0.045;
          inst.badgeGroup.position.y = 0.66 + floatOffset + inst.lift;
          inst.badgeShadow.scale.set(1 - (floatOffset + inst.lift) * 1.8, 1 - (floatOffset + inst.lift) * 1.8, 1);
          inst.badgeShadow.material.opacity = Math.max(0.12, 0.45 - (floatOffset + inst.lift) * 1.2);

          const idleRotY = Math.sin(elapsed * 1.1 + inst.cardIndex * 1.1) * 0.05;
          inst.badgeGroup.rotation.y += (inst.targetRotY + idleRotY - inst.badgeGroup.rotation.y) * 0.045;
          inst.badgeGroup.rotation.x += (inst.targetRotX - inst.badgeGroup.rotation.x) * 0.045;
        } else {
          inst.badgeGroup.position.y = 0.66;
        }

        inst.renderer.render(inst.scene, inst.camera);
      });
    }

    animate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArchScenes);
  } else {
    initArchScenes();
  }
</script>
