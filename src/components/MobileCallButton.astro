---
import { siteConfig } from "../data/siteConfig";
---

<!-- Floating Call Bar for Mobile Devices -->
<div class="sm:hidden fixed bottom-4 left-4 right-4 z-40">
  <div class="p-2 rounded-2xl bg-zinc-950/95 backdrop-blur-md border border-zinc-800 shadow-2xl flex items-center gap-2">
    <!-- Call Now Button -->
    <a
      href={`tel:${siteConfig.phoneRaw}`}
      class="flex-1 flex items-center justify-center gap-2.5 px-4 py-3.5 rounded-xl bg-[#ccff00] text-zinc-950 font-extrabold text-sm shadow-md active:scale-[0.98] transition-transform"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Zadzwoń teraz</span>
    </a>

    <!-- Copy Phone Button -->
    <button
      type="button"
      data-copy-phone={siteConfig.phone}
      class="p-3.5 rounded-xl bg-zinc-900 text-zinc-300 border border-zinc-800 hover:text-white active:scale-[0.98] transition-all shrink-0"
      aria-label="Kopiuj numer telefonu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
    </button>
  </div>
</div>
