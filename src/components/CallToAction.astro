---
---

<section id="kontakt" class="py-20 md:py-32 bg-[#fcfbfa]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-[#0c0d12] text-white p-8 sm:p-12 lg:p-16 border border-zinc-800 shadow-2xl reveal-on-scroll">
      
      <!-- Subtle architectural dot pattern -->
      <div class="absolute inset-0 opacity-[0.04] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
      
      <!-- Ambient Glow in background -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-[#ccff00]/10 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Editorial Offer & Guarantee (Span 7) -->
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.12]">
            Porozmawiajmy o nowych zleceniach dla Twojej firmy.
          </h2>

          <p class="text-base sm:text-lg text-zinc-400 font-normal leading-relaxed max-w-xl">
            Bez zbędnego żargonu i bez zobowiązań. W 15 minut przeanalizujemy Twoją branżę i ustalimy, jak zdobyć przewagę nad lokalną konkurencją.
          </p>

          <!-- 3 concrete trust points with SVG checkmarks -->
          <div class="pt-2 space-y-3">
            <div class="flex items-center gap-3 text-sm font-semibold text-zinc-300">
              <svg class="w-4 h-4 text-[#ccff00] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Rozmawiasz bezpośrednio ze mną — bez pośredników i handlowców</span>
            </div>
            <div class="flex items-center gap-3 text-sm font-semibold text-zinc-300">
              <svg class="w-4 h-4 text-[#ccff00] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Stała, z góry ustalona cena przed startem prac</span>
            </div>
            <div class="flex items-center gap-3 text-sm font-semibold text-zinc-300">
              <svg class="w-4 h-4 text-[#ccff00] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Odpowiedź na zapytanie w maksymalnie 2 godziny</span>
            </div>
          </div>

          <div class="pt-6 border-t border-zinc-800/80 flex items-center gap-3 text-xs text-zinc-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <span>Wypełnij formularz obok — odpiszę lub oddzwonię z konkretną analizą i wyceną.</span>
          </div>
        </div>

        <!-- Right Column: Quick Quote Inquiry Form (Span 5) -->
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-8 rounded-3xl bg-[#14151b] border border-zinc-800 shadow-xl relative">
            
            <div class="mb-5">
              <h3 class="text-xl font-extrabold text-white tracking-tight">
                Szybkie zapytanie o wycenę
              </h3>
              <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
                Zostaw kontakt i czym się zajmujesz — odezwę się z konkretną propozycją.
              </p>
            </div>

            <form id="cta-inquiry-form" class="space-y-3.5">
              <div>
                <label for="cta-contact" class="block text-[11px] font-bold text-zinc-400 mb-1">Twój telefon lub e-mail</label>
                <input 
                  type="text" 
                  id="cta-contact" 
                  name="contact" 
                  required 
                  placeholder="np. 600 123 456 lub biuro@firma.pl"
                  class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700/80 text-white text-sm placeholder-zinc-500 focus:outline-none focus:border-[#ccff00] focus:ring-1 focus:ring-[#ccff00] transition-all"
                />
              </div>

              <div>
                <label for="cta-business" class="block text-[11px] font-bold text-zinc-400 mb-1">Czym zajmuje się Twoja firma?</label>
                <input 
                  type="text" 
                  id="cta-business" 
                  name="business" 
                  required 
                  placeholder="np. serwis HVAC, brukarstwo, warsztat"
                  class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700/80 text-white text-sm placeholder-zinc-500 focus:outline-none focus:border-[#ccff00] focus:ring-1 focus:ring-[#ccff00] transition-all"
                />
              </div>

              <div>
                <label for="cta-note" class="block text-[11px] font-bold text-zinc-400 mb-1">Czego potrzebujesz? (opcjonalnie)</label>
                <textarea 
                  id="cta-note" 
                  name="note" 
                  rows="2"
                  placeholder="np. nowa strona WWW, reklamy Google, profil w mapach"
                  class="w-full px-4 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700/80 text-white text-sm placeholder-zinc-500 focus:outline-none focus:border-[#ccff00] focus:ring-1 focus:ring-[#ccff00] transition-all resize-none"
                ></textarea>
              </div>

              <div class="pt-2 space-y-2.5">
                <button 
                  type="submit"
                  class="w-full py-3.5 px-6 rounded-xl bg-[#ccff00] text-zinc-950 text-sm font-extrabold shadow-md hover:bg-[#bbf000] transition-all flex items-center justify-center gap-2 btn-tactile cursor-pointer"
                >
                  <span>Wyślij zapytanie w 15 sekund</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </button>

                <div class="flex items-center justify-between text-[11px] text-zinc-500 font-medium px-1">
                  <span>Bez spamu i bez zobowiązań</span>
                  <span>Odpowiedź w 2h</span>
                </div>
              </div>

              <!-- Feedback message container -->
              <div id="cta-form-status" class="hidden p-3 rounded-xl bg-emerald-950/80 border border-emerald-800 text-emerald-300 text-xs font-semibold text-center mt-2">
                Dziękuję! Twoje zapytanie zostało przygotowane. Skontaktuję się wkrótce.
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("cta-inquiry-form") as HTMLFormElement | null;
  const statusBox = document.getElementById("cta-form-status");

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const contact = formData.get("contact") || "";
      const business = formData.get("business") || "";
      const note = formData.get("note") || "";

      // Construct mailto link as instant fallback or API hook
      const subject = encodeURIComponent(`Zapytanie o ofertę: ${business}`);
      const body = encodeURIComponent(`Kontakt: ${contact}\nBranża: ${business}\nSzczegóły: ${note}`);
      
      if (statusBox) {
        statusBox.classList.remove("hidden");
      }

      form.reset();
      
      setTimeout(() => {
        window.location.href = `mailto:kamil@kamilpitner.pl?subject=${subject}&body=${body}`;
      }, 600);
    });
  }
</script>
