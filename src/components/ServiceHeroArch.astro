const config = serviceConfigs[serviceId];
---

<div
  class={`single-arch-card relative flex flex-col justify-end overflow-hidden rounded-t-full rounded-b-[40px] sm:rounded-b-none ${config.bgClass} border border-b-0 px-6 pt-12 pb-0 w-full max-w-[320px] sm:max-w-[360px] min-h-[380px] sm:min-h-[420px] lg:min-h-[460px] shadow-sm select-none mx-auto ${className}`}
  data-service-id={serviceId}
  data-pedestal-hex={config.pedestalHex}
  data-icon-json={JSON.stringify(config.iconData)}
>
  <!-- 3D Pedestal & Logo Stage -->
  <div class="relative w-full h-72 sm:h-80 lg:h-88 flex items-center justify-center">
    <canvas class="single-arch-canvas w-full h-full block pointer-events-none"></canvas>
  </div>
</div>

<script>
  import * as THREE from "three";

  function initSingleArchScenes() {
    const cardElements = document.querySelectorAll(".single-arch-card");
    if (!cardElements.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Helper: Create soft radial contact shadow texture
    function createShadowTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 256;
      canvas.height = 256;
      const ctx = canvas.getContext("2d");
      if (!ctx) return null;

      const grad = ctx.createRadialGradient(128, 128, 0, 128, 128, 120);
      grad.addColorStop(0, "rgba(0, 0, 0, 0.38)");
      grad.addColorStop(0.4, "rgba(0, 0, 0, 0.16)");
      grad.addColorStop(0.8, "rgba(0, 0, 0, 0.04)");
      grad.addColorStop(1, "rgba(0, 0, 0, 0)");

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(128, 128, 128, 0, Math.PI * 2);
      ctx.fill();

      const tex = new THREE.CanvasTexture(canvas);
      tex.needsUpdate = true;
      return tex;
    }

    const shadowTexture = createShadowTexture();

    // Helper: Draw crisp official vector logos
    function createLogoTexture(iconConfig: any) {
      const canvas = document.createElement("canvas");
      canvas.width = 1024;
      canvas.height = 1024;
      const ctx = canvas.getContext("2d");
      if (!ctx) return null;

      const bgGrad = ctx.createLinearGradient(0, 0, 1024, 1024);
      bgGrad.addColorStop(0, "#ffffff");
      bgGrad.addColorStop(0.6, "#fafafa");
      bgGrad.addColorStop(1, "#f4f4f5");
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, 1024, 1024);

      // Soft inner rim aligned with squircle
      ctx.strokeStyle = "rgba(0, 0, 0, 0.05)";
      ctx.lineWidth = 16;
      ctx.beginPath();
      ctx.roundRect(48, 48, 928, 928, 200);
      ctx.stroke();

      const targetSize = 560;
      const vb = iconConfig.viewBox || { x: 0, y: 0, width: 24, height: 24 };
      const scale = targetSize / Math.max(vb.width, vb.height);
      const scaledW = vb.width * scale;
      const scaledH = vb.height * scale;
      const offsetX = (1024 - scaledW) / 2 - vb.x * scale;
      const offsetY = (1024 - scaledH) / 2 - vb.y * scale;

      ctx.save();
      ctx.translate(offsetX, offsetY);
      ctx.scale(scale, scale);

      if (iconConfig.type === "multi" && Array.isArray(iconConfig.layers)) {
        iconConfig.layers.forEach((layer: any) => {
          if (layer.path) {
            const p = new Path2D(layer.path);
            ctx.fillStyle = layer.color;
            ctx.fill(p);
          } else if (layer.type === "ellipse") {
            ctx.fillStyle = layer.color;
            ctx.beginPath();
            ctx.ellipse(layer.cx, layer.cy, layer.rx, layer.ry, 0, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      } else if (iconConfig.path) {
        const p = new Path2D(iconConfig.path);
        ctx.fillStyle = iconConfig.brandColor || "#18181b";
        ctx.fill(p);
      }

      ctx.restore();

      const texture = new THREE.CanvasTexture(canvas);
      texture.anisotropy = 16;
      texture.needsUpdate = true;
      return texture;
    }

    // Helper: Create Squircle shape
    function createSquircleShape(size: number, radius: number) {
      const shape = new THREE.Shape();
      const x = -size / 2;
      const y = -size / 2;
      const w = size;
      const h = size;
      const r = radius;

      shape.moveTo(x + r, y);
      shape.lineTo(x + w - r, y);
      shape.quadraticCurveTo(x + w, y, x + w, y + r);
      shape.lineTo(x + w, y + h - r);
      shape.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      shape.lineTo(x + r, y + h);
      shape.quadraticCurveTo(x, y + h, x, y + h - r);
      shape.lineTo(x, y + r);
      shape.quadraticCurveTo(x, y, x + r, y);

      return shape;
    }

    const instances: Array<{
      renderer: THREE.WebGLRenderer;
      scene: THREE.Scene;
      camera: THREE.PerspectiveCamera;
      badgeGroup: THREE.Group;
      pedestalMesh: THREE.Mesh;
      pedestalShadow: THREE.Mesh;
      badgeShadow: THREE.Mesh;
      targetRotX: number;
      targetRotY: number;
      targetLift: number;
      lift: number;
    }> = [];

    const squircleShape = createSquircleShape(1.68, 0.38);
    const squircleGeom = new THREE.ExtrudeGeometry(squircleShape, {
      depth: 0.14,
      bevelEnabled: true,
      bevelThickness: 0.035,
      bevelSize: 0.035,
      bevelSegments: 4,
    });
    squircleGeom.center();

    squircleGeom.computeBoundingBox();
    const bb = squircleGeom.boundingBox!;
    const sizeX = bb.max.x - bb.min.x;
    const sizeY = bb.max.y - bb.min.y;
    const uvAttr = squircleGeom.attributes.uv;
    for (let i = 0; i < uvAttr.count; i++) {
      const u = (squircleGeom.attributes.position.getX(i) - bb.min.x) / sizeX;
      const v = (squircleGeom.attributes.position.getY(i) - bb.min.y) / sizeY;
      uvAttr.setXY(i, u, v);
    }
    uvAttr.needsUpdate = true;

    const pedestalGeom = new THREE.CylinderGeometry(1.38, 1.48, 0.24, 64);
    const shadowGeom = new THREE.PlaneGeometry(3.4, 3.4);
    const badgeShadowGeom = new THREE.PlaneGeometry(1.6, 0.75);

    cardElements.forEach((cardEl) => {
      const canvas = cardEl.querySelector(".single-arch-canvas") as HTMLCanvasElement;
      if (!canvas) return;

      const iconJson = JSON.parse(cardEl.getAttribute("data-icon-json") || "{}");
      const pedestalHex = cardEl.getAttribute("data-pedestal-hex") || "#e5e7eb";

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
      camera.position.set(0, 1.05, 4.7);
      camera.lookAt(0, 0.3, 0);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 1.5);
      scene.add(ambientLight);

      const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
      keyLight.position.set(-2.5, 5, 4.5);
      scene.add(keyLight);

      const fillLight = new THREE.DirectionalLight(0xfff7ed, 1.0);
      fillLight.position.set(3, 2, 2.5);
      scene.add(fillLight);

      // Contact shadow beneath pedestal
      const pedestalShadowMat = new THREE.MeshBasicMaterial({
        map: shadowTexture,
        transparent: true,
        opacity: 0.65,
        depthWrite: false,
      });
      const pedestalShadow = new THREE.Mesh(shadowGeom, pedestalShadowMat);
      pedestalShadow.rotation.x = -Math.PI / 2;
      pedestalShadow.position.set(0, -0.48, 0);
      scene.add(pedestalShadow);

      // Pedestal Cylinder
      const pedestalColorNum = parseInt(pedestalHex.replace("#", "0x"), 16);
      const pedestalMat = new THREE.MeshStandardMaterial({
        color: pedestalColorNum,
        roughness: 0.7,
        metalness: 0.05,
      });
      const pedestalMesh = new THREE.Mesh(pedestalGeom, pedestalMat);
      pedestalMesh.position.set(0, -0.36, 0);
      scene.add(pedestalMesh);

      // Logo Badge Group
      const badgeGroup = new THREE.Group();
      badgeGroup.position.set(0, 0.66, 0);
      scene.add(badgeGroup);

      const logoTexture = createLogoTexture(iconJson);
      const faceMaterial = new THREE.MeshStandardMaterial({
        map: logoTexture,
        roughness: 0.2,
        metalness: 0.08,
      });

      const edgeMaterial = new THREE.MeshStandardMaterial({
        color: 0xf4f4f5,
        roughness: 0.25,
        metalness: 0.15,
      });

      const badgeMesh = new THREE.Mesh(squircleGeom, [faceMaterial, edgeMaterial]);
      badgeGroup.add(badgeMesh);

      // Dynamic shadow cast on top of the pedestal
      const badgeShadowMat = new THREE.MeshBasicMaterial({
        map: shadowTexture,
        transparent: true,
        opacity: 0.45,
        depthWrite: false,
      });
      const badgeShadow = new THREE.Mesh(badgeShadowGeom, badgeShadowMat);
      badgeShadow.rotation.x = -Math.PI / 2;
      badgeShadow.position.set(0, -0.23, 0);
      scene.add(badgeShadow);

      const instance = {
        renderer,
        scene,
        camera,
        badgeGroup,
        pedestalMesh,
        pedestalShadow,
        badgeShadow,
        targetRotX: 0,
        targetRotY: 0,
        targetLift: 0,
        lift: 0,
      };

      instances.push(instance);

      // Mouse Parallax & Hover Elevation
      (cardEl as HTMLElement).addEventListener("pointerenter", () => {
        instance.targetLift = 0.14;
      });

      (cardEl as HTMLElement).addEventListener("pointermove", (e: PointerEvent) => {
        const rect = (cardEl as HTMLElement).getBoundingClientRect();
        const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const normY = ((e.clientY - rect.top) / rect.height) * 2 - 1;

        instance.targetRotY = normX * 0.38;
        instance.targetRotX = -normY * 0.28;
        instance.targetLift = 0.14;
      });

      (cardEl as HTMLElement).addEventListener("pointerleave", () => {
        instance.targetRotX = 0;
        instance.targetRotY = 0;
        instance.targetLift = 0;
      });
    });

    // Handle Resize
    window.addEventListener("resize", () => {
      instances.forEach(({ renderer, camera }) => {
        const canvas = renderer.domElement;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (width === 0 || height === 0) return;

        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height, false);
      });
    });

    // 60fps Animation Loop
    let clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      instances.forEach((inst) => {
        const canvas = inst.renderer.domElement;
        if (canvas.clientWidth === 0 || canvas.clientHeight === 0) return;

        // Smooth physics interpolation (LERP)
        inst.badgeGroup.rotation.y += (inst.targetRotY - inst.badgeGroup.rotation.y) * 0.08;
        inst.badgeGroup.rotation.x += (inst.targetRotX - inst.badgeGroup.rotation.x) * 0.08;

        inst.lift += (inst.targetLift - inst.lift) * 0.08;

        // Subtle organic levitation
        const floatY = prefersReducedMotion ? 0 : Math.sin(elapsedTime * 1.8) * 0.045;
        const floatTilt = prefersReducedMotion ? 0 : Math.cos(elapsedTime * 1.4) * 0.025;

        inst.badgeGroup.position.y = 0.66 + floatY + inst.lift;
        inst.badgeGroup.rotation.z = floatTilt;

        // Scale shadow based on height
        const shadowScale = 1 - (floatY + inst.lift) * 1.2;
        inst.badgeShadow.scale.set(Math.max(0.5, shadowScale), Math.max(0.5, shadowScale), 1);
        (inst.badgeShadow.material as THREE.MeshBasicMaterial).opacity = 0.45 * Math.max(0.4, shadowScale);

        inst.renderer.render(inst.scene, inst.camera);
      });
    }

    animate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSingleArchScenes);
  } else {
    initSingleArchScenes();
  }
</script>
