  },
  "google-ads": {
    bgClass: "bg-[#e0f2fe] border-[#cbe4f9]",
    pedestalHex: "#cde4f7",
    iconData: {
      type: "multi",
      viewBox: { x: 0, y: -13, width: 256, height: 256 },
      layers: [
        {
