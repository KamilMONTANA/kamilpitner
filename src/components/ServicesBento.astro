---
import { siteConfig } from "../data/siteConfig";
---

<!-- 1. DEDICATED SECTION: STRONY WWW (Pastel Blush / Rose matching Card 0) -->
<section id="strony-www" class="py-20 md:py-28 bg-[#fae8e8]/50 border-b border-[#f5d0d4] relative overflow-hidden">
  <div id="uslugi" class="absolute -top-10"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Text Left (Span 7) -->
      <div class="lg:col-span-7 space-y-6 reveal-on-scroll">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight leading-[1.15]">
          Strony WWW, które sprzedają.
        </h2>

        <p class="text-base sm:text-lg md:text-xl text-zinc-600 font-normal leading-relaxed max-w-2xl">
          Projektuję błyskawiczne strony nastawione na bezpośredni kontakt ze smartfona. Klient w ułamku sekundy widzi czym się zajmujesz i jednym kliknięciem dzwoni do Twojej firmy.
        </p>

        <!-- 3 Scannable Business Points -->
        <ul class="space-y-3.5 pt-2">
          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">100% pod telefony:</strong> Ponad 80% lokalnych klientów dzwoni ze smartfona – numer telefonu jest zawsze pod kciukiem.</span>
          </li>

          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Błyskawiczne ładowanie:</strong> Strona otwiera się w ułamku sekundy, więc nikt nie rezygnuje z czekania na ofertę.</span>
          </li>

          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Kompleksowe wdrożenie:</strong> Biorę na siebie teksty, zdjęcia, domenę i serwer. Nie musisz się na niczym znać.</span>
          </li>
        </ul>

        <div class="pt-2">
          <a
            href="/strony-www"
            class="inline-flex items-center gap-2 text-sm font-bold text-zinc-900 hover:text-black group underline underline-offset-4 decoration-zinc-400 hover:decoration-zinc-950 transition-colors"
          >
            <span>Zobacz pełną ofertę i etapy wdrożenia stron WWW</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Graphic Element Right (Span 5): Tactile Mobile Speed & Direct Call Card -->
      <div class="lg:col-span-5 reveal-on-scroll delay-100">
        <div class="relative bg-white rounded-3xl p-6 sm:p-7 shadow-[0_20px_50px_-15px_rgba(235,160,165,0.25)] border border-[#f5d0d4] max-w-md mx-auto">
          
          <!-- Mockup Browser Header -->
          <div class="flex items-center justify-between pb-4 border-b border-zinc-100">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-100 text-zinc-700 text-xs font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
              </svg>
              <span>twoja-firma.pl</span>
            </div>
            <div class="w-2.5"></div>
          </div>

          <!-- Mockup Body Content -->
          <div class="pt-5 space-y-4">
            <!-- Speed Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Czas ładowania: 0.5 sekundy</span>
            </div>

            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-zinc-600">Usługi Lokalne • Twoje Miasto</div>
              <div class="text-xl font-extrabold text-zinc-950 mt-1">Szybki dojazd do klienta & gwarancja jakości</div>
            </div>

            <!-- Prominent Call Button in Mockup -->
            <div class="p-4 rounded-2xl bg-zinc-950 text-white flex items-center justify-between shadow-md">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#ccff00] text-zinc-950 flex items-center justify-center font-bold">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                  </svg>
                </div>
                <div>
                  <div class="text-[11px] text-zinc-400 font-medium">Jeden klik i klient dzwoni:</div>
                  <div class="text-sm font-extrabold text-white">+48 600 000 000</div>
                </div>
              </div>
              <span class="text-xs font-bold text-[#ccff00] bg-zinc-900 px-2.5 py-1 rounded-md">Zadzwoń</span>
            </div>

            <!-- Micro Trust Bar -->
            <div class="flex items-center justify-between text-xs text-zinc-500 pt-1">
              <span>✓ Wolne terminy na ten tydzień</span>
              <span class="font-bold text-zinc-800">100% pod smartfony</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- 2. DEDICATED SECTION: GOOGLE ADS (Pastel Sky Blue matching Card 1) -->
<section id="google-ads" class="py-20 md:py-28 bg-[#e0f2fe]/50 border-b border-[#cbe4f9] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Graphic Element Left (Span 5): Google Search Sponsored Ad Snippet -->
      <div class="lg:col-span-5 order-2 lg:order-1 reveal-on-scroll">
        <div class="relative bg-white rounded-3xl p-6 sm:p-7 shadow-[0_20px_50px_-15px_rgba(180,215,245,0.3)] border border-[#cbe4f9] max-w-md mx-auto">
          
          <!-- Google Search Mockup Bar -->
          <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-zinc-100/90 border border-zinc-200 mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="text-xs sm:text-sm font-semibold text-zinc-800">[Twoja Usługa] [Twoje Miasto]</span>
          </div>

          <!-- Real Sponsored Ad Card -->
          <div class="space-y-2.5 p-4 rounded-2xl bg-sky-50/40 border border-sky-100">
            <div class="flex items-center gap-2 text-xs">
              <span class="font-extrabold text-zinc-900 bg-white px-2 py-0.5 rounded border border-zinc-200">Sponsorowane</span>
              <span class="text-zinc-500 truncate">twoja-firma.pl/oferta</span>
            </div>

            <div class="text-base sm:text-lg font-bold text-blue-700 leading-snug">
              Profesjonalne Usługi w Twojej Okolicy | Szybki Dojazd
            </div>

            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
              Szukasz rzetelnego wykonawcy? Zadzwoń od ręki i zamów usługę. Ceny bez ukrytych kosztów i gwarancja terminowości.
            </p>

            <!-- Call Extension in Ad -->
            <div class="pt-2 border-t border-sky-200/60 flex items-center justify-between">
              <div class="inline-flex items-center gap-2 text-xs font-bold text-zinc-900 bg-white px-3 py-1.5 rounded-lg border border-sky-200 shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
                <span>Połącz: +48 600...</span>
              </div>
              <span class="text-[11px] font-bold text-emerald-800 bg-emerald-50 px-2 py-1 rounded">Aktywne teraz</span>
            </div>
          </div>

          <!-- Bottom Stat Banner -->
          <div class="mt-4 p-3 rounded-xl bg-zinc-900 text-white flex items-center justify-between text-xs">
            <span class="text-zinc-400">Efekt kampanii:</span>
            <span class="font-bold text-[#ccff00]">Tylko dzwoniący klienci</span>
          </div>

        </div>
      </div>

      <!-- Text Right (Span 7) -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-6 reveal-on-scroll delay-100">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight leading-[1.15]">
          Dochodowe kampanie Google Ads.
        </h2>

        <p class="text-base sm:text-lg md:text-xl text-zinc-600 font-normal leading-relaxed max-w-2xl">
          Uruchamiam reklamy trafiające wyłącznie do osób, które w tym momencie szukają Twoich usług w wyszukiwarce. Płacisz za realne zlecenia i telefony, a nie za puste wyświetlenia.
        </p>

        <!-- 3 Scannable Business Points -->
        <ul class="space-y-3.5 pt-2">
          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Klienci z portfelem w ręku:</strong> Reklama pojawia się tylko wtedy, gdy ktoś w Twoim mieście wpisuje nazwę Twojej usługi.</span>
          </li>

          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">100% budżetu na reklamę:</strong> Zero prowizji procentowej od wydatków. Każda złotówka pracuje na Twoje telefony.</span>
          </li>

          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Jasne podsumowania:</strong> Co miesiąc widzisz czarno na białym ile połączeń i zapytań wygenerowały reklamy.</span>
          </li>
        </ul>

        <div class="pt-2">
          <a
            href="/google-ads"
            class="inline-flex items-center gap-2 text-sm font-bold text-zinc-900 hover:text-black group underline underline-offset-4 decoration-zinc-400 hover:decoration-zinc-950 transition-colors"
          >
            <span>Zobacz szczegóły prowadzenia i rozliczania kampanii Ads</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 3. DEDICATED SECTION: GOOGLE MOJA FIRMA (Pastel Mint / Sage matching Card 2) -->
<section id="google-moja-firma" class="py-20 md:py-28 bg-[#eff5ec]/70 border-b border-[#dbe8d6] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Text Left (Span 7) -->
      <div class="lg:col-span-7 space-y-6 reveal-on-scroll">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight leading-[1.15]">
          Wizytówki Google i pozycjonowanie w Mapach.
        </h2>

        <p class="text-base sm:text-lg md:text-xl text-zinc-600 font-normal leading-relaxed max-w-2xl">
          Bądź pierwszym wyborem w swoim mieście. Gdy lokalny klient wpisuje usługę w telefonie, Twoja wizytówka wyświetla się na samej górze w pierwszej trójce Map Google.
        </p>

        <!-- 3 Scannable Business Points -->
        <ul class="space-y-3.5 pt-2">
          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Top 3 w Twoim mieście:</strong> Wypozycjonowanie profilu tak, by mieszkańcy widzieli Twoją firmę przed konkurencją.</span>
          </li>

          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Stały napływ bezpłatnych zleceń:</strong> Klienci klikają „Zadzwoń” lub wyznaczają trasę bezpośrednio z poziomu Map.</span>
          </li>

          <li class="flex items-start gap-3.5 text-sm sm:text-base text-zinc-800 font-medium">
            <div class="w-5 h-5 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span><strong class="text-zinc-950 font-bold">Ochrona profilu:</strong> Profesjonalna konfiguracja kategorii i zabezpieczenie przed fałszywymi zgłoszeniami konkurencji.</span>
          </li>
        </ul>

        <div class="pt-2">
          <a
            href="/google-moja-firma"
            class="inline-flex items-center gap-2 text-sm font-bold text-zinc-900 hover:text-black group underline underline-offset-4 decoration-zinc-400 hover:decoration-zinc-950 transition-colors"
          >
            <span>Wszystko o pozycjonowaniu wizytówki w Mapach Google</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Graphic Element Right (Span 5): Google Maps Profile Card -->
      <div class="lg:col-span-5 reveal-on-scroll delay-100">
        <div class="relative bg-white rounded-3xl p-6 sm:p-7 shadow-[0_20px_50px_-15px_rgba(190,225,190,0.3)] border border-[#dbe8d6] max-w-md mx-auto">
          
          <!-- Google Maps Mini Header -->
          <div class="relative h-28 rounded-2xl bg-emerald-100/60 border border-emerald-200/80 overflow-hidden flex items-center justify-center mb-4">
            <!-- Stylized grid street lines -->
            <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
            <div class="relative z-10 flex flex-col items-center">
              <div class="w-9 h-9 rounded-full bg-red-500 text-white flex items-center justify-center shadow-lg border-2 border-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="mt-1 px-2.5 py-0.5 rounded-full bg-white text-zinc-900 font-extrabold text-[10px] shadow-sm border border-zinc-200">
                #1 w Twoim Mieście
              </span>
            </div>
          </div>

          <!-- Business Profile Details -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="text-base sm:text-lg font-extrabold text-zinc-950">Twoja Firma Usługowa</span>
                <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </div>
            </div>

            <!-- Star Rating in Google Maps -->
            <div class="flex items-center gap-2">
              <span class="text-xs font-extrabold text-zinc-900">5.0</span>
              <div class="flex text-amber-400 text-xs">★★★★★</div>
              <span class="text-xs text-zinc-500 font-medium">(94 opinie w Google)</span>
            </div>

            <p class="text-xs text-zinc-600">
              Otwarte teraz • Obsługuje całe Twoje miasto i okoliczne miejscowości
            </p>

            <!-- 3 Maps Action Buttons -->
