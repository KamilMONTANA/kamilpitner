---
import { siteConfig } from "../data/siteConfig";
---

<section id="proces" class="py-20 md:py-32 bg-zinc-950 text-white border-b border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-800 text-[#ccff00] text-xs font-bold uppercase tracking-wider mb-4 border border-zinc-700">
        <span>Przejrzysty Proces</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Od telefonu do pierwszych zapytań w 3 prostych krokach.
      </h2>
      <p class="text-lg sm:text-xl text-zinc-400 font-normal leading-relaxed">
        Zero skomplikowanych umów na 50 stron i wielotygodniowych debat. Skupiamy się na tym, co przynosi klientów Twojej firmie.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {siteConfig.processSteps.map((step, idx) => (
        <div class={`relative bg-zinc-900 rounded-3xl p-8 border border-zinc-800 flex flex-col justify-between hover:border-zinc-700 transition-colors group card-hover-depth-dark reveal-on-scroll delay-${(idx + 1) * 100}`}>
          <div>
            <!-- Step Header -->
            <div class="flex items-center justify-between mb-8">
              <span class="text-4xl sm:text-5xl font-extrabold text-[#ccff00] tracking-tight tabular-nums">
                {step.number}
              </span>
              <span class="text-xs px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 font-semibold border border-zinc-700">
                {step.duration}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-4 tracking-tight">
              {step.title}
            </h3>

            <p class="text-zinc-400 text-sm sm:text-base leading-relaxed mb-6">
              {step.description}
            </p>
          </div>

          <!-- Step Progress indicator / link -->
          <div class="pt-6 border-t border-zinc-800/80 flex items-center justify-between text-xs font-semibold text-zinc-500">
            <span>Krok {idx + 1} z 3</span>
            {idx === 0 && (
              <a href={`tel:${siteConfig.phoneRaw}`} class="text-[#ccff00] hover:underline flex items-center gap-1">
                <span>Zadzwoń teraz</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Banner below steps -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-zinc-900/60 border border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-6 reveal-on-scroll">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[#ccff00] text-zinc-950 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base sm:text-lg font-bold text-white">Chcesz sprawdzić, ile potrwa realizacja dla Twojej firmy?</h4>
          <p class="text-xs sm:text-sm text-zinc-400">Podczas 10-minutowej rozmowy określę dokładny harmonogram i koszt.</p>
        </div>
      </div>
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-zinc-950 text-sm font-extrabold hover:bg-zinc-100 transition-colors shrink-0 shadow-sm btn-tactile"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Zadzwoń: {siteConfig.phone}</span>
      </a>
    </div>
  </div>
</section>
