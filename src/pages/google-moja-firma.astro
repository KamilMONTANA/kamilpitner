---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallButton from "../components/MobileCallButton.astro";
import CallToAction from "../components/CallToAction.astro";
import ServiceHeroArch from "../components/ServiceHeroArch.astro";
import { siteConfig } from "../data/siteConfig";
---

<Layout
  title="Pozycjonowanie w Mapach Google i Profil Firmy | Kamil Pitner"
  description="Profesjonalna optymalizacja i pozycjonowanie Profilu Firmy w Mapach Google (Local 3-Pack). Zdobądź bezpłatny napływ zleceń od lokalnych klientów."
>
  <Header />

  <main>
    <!-- Subpage Hero -->
    <section class="py-16 md:py-24 bg-[#eff5ec]/70 border-b border-[#dbe8d6] relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-zinc-950 transition-colors">Strona główna</a>
          <span>/</span>
          <a href="/#uslugi" class="hover:text-zinc-950 transition-colors">Usługi</a>
          <span>/</span>
          <span class="text-zinc-900">Google Moja Firma</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-950 tracking-tight leading-[1.12]">
              Wizytówki Google i Mapy – Bądź nr 1 w swoim mieście.
            </h1>

            <p class="text-lg sm:text-xl text-zinc-700 font-normal leading-relaxed">
              Gdy lokalny klient szuka fachowca w telefonie, Twoja firma pojawia się na samej górze w pierwszej trójce Map Google. Zdobądź bezpłatny napływ zleceń od lokalnych mieszkańców.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
              <a
                href={`tel:${siteConfig.phoneRaw}`}
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-zinc-950 text-white text-base font-extrabold shadow-xl hover:bg-zinc-800 transition-all border border-zinc-900 btn-tactile"
              >
                <span>Porozmawiajmy o wizytówce</span>
              </a>
              <a
                href="/"
                class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-2xl bg-white text-zinc-800 text-base font-bold hover:bg-zinc-100 border border-zinc-300 transition-all"
              >
                <span>← Wróć do strony głównej</span>
              </a>
            </div>
          </div>

          <!-- Hero Graphic Right (Span 5): 3D Service Arch Card (Google Moja Firma) -->
          <div class="lg:col-span-5 reveal-on-scroll delay-100 flex items-center justify-center">
            <ServiceHeroArch serviceId="google-moja-firma" />
          </div>

        </div>

      </div>
    </section>

    <!-- Value Grid: Asymmetric Bento Grid -->
    <section class="py-20 md:py-28 bg-[#fcfbfa] border-b border-[#e7e5e4]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16 reveal-on-scroll">
          <span class="text-xs font-extrabold uppercase tracking-wider text-zinc-400">Lokalna Widoczność w Google</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight mt-1 mb-4">
            Dlaczego pierwsza trójka w Mapach Google (Local 3-Pack) to fundament biznesu?
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 leading-relaxed">
            Dla lokalnego usługodawcy profil w Mapach Google to bezkonkurencyjne, całkowicie darmowe źródło kontaktów. Ponad 70% klientów dzwoni do jednej z trzech pierwszych firm wyświetlonych na mapie w telefonie.
          </p>
        </div>

        <!-- Asymmetric Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

          <!-- Card 1 (Span 7, Light #ffffff): Widoczność w Local 3-Pack -->
          <div class="md:col-span-7 p-8 sm:p-10 rounded-3xl bg-white border border-zinc-200 shadow-xs flex flex-col justify-between space-y-6 hover:border-zinc-300 transition-all card-hover-depth reveal-on-scroll delay-100">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-zinc-950 text-[#ccff00] flex items-center justify-center shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold text-zinc-950 tracking-tight">
                Widoczność w złotej trójce – tam, gdzie decyduje się 70% klientów
              </h3>
              <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
                Szukając fachowca w telefonie, mieszkaniec Twojego miasta nie przegląda dziesiątek stron internetowych. Wybiera jedną z firm na szczycie Map Google. Pozycjonuję Twój profil tak, aby w Twojej okolicy pojawiał się w ścisłym Top 3 z maksymalną liczbą pozytywnych wyróżników.
              </p>
            </div>

            <!-- Realistic Google Maps Local 3-Pack Mockup Widget -->
            <div class="p-5 rounded-2xl bg-[#fcfbfa] border border-zinc-200 space-y-3 font-sans">
              <div class="flex items-center justify-between text-xs pb-2 border-b border-zinc-200/80">
                <div class="flex items-center gap-2 text-zinc-500 font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                  <span>Wyniki lokalne: Twoje Miasto i okolice</span>
                </div>
                <span class="text-[11px] font-extrabold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  Pozycja #1 w Mapach
                </span>
              </div>

              <!-- Top 1 Listing -->
              <div class="space-y-1.5 pt-1">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h4 class="text-base font-extrabold text-zinc-950 leading-snug">Twoja Firma Usługowa</h4>
                    <div class="flex items-center gap-2 text-xs mt-0.5">
                      <span class="font-extrabold text-amber-500 flex items-center gap-1">
                        4.9
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      </span>
                      <span class="text-zinc-500 font-medium">(54 opinie) • Usługi specjalistyczne</span>
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="text-[11px] font-bold text-emerald-700 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Otwarte teraz
                    </span>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-600 pt-1">
                  <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 font-medium text-[11px]">Obsługiwany obszar: do 30 km</span>
                  <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 font-medium text-[11px]">Wycena na miejscu</span>
                  <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 font-medium text-[11px]">Szybki dojazd</span>
                </div>

                <div class="pt-2 flex items-center justify-between border-t border-zinc-200/80">
                  <div class="text-xs text-zinc-500 font-medium">Telefon bezpośredni pod kciukiem w aplikacji Map</div>
                  <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-950 text-white text-xs font-bold shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span>Zadzwoń</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2 (Span 5, Dark Contrast #0c0d12 / #09090b): Bezpłatne zapytania -->
          <div class="md:col-span-5 p-8 sm:p-10 rounded-3xl bg-zinc-950 text-white shadow-xl flex flex-col justify-between space-y-6 card-hover-depth-dark reveal-on-scroll delay-200">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 text-[#ccff00] flex items-center justify-center shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold tracking-tight text-white">
                Bezpłatny dopływ zleceń bez płacenia za kliknięcia
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed">
                W przeciwieństwie do płatnych reklam, ruch z Map Google jest w 100% darmowy. Za wykonane połączenia, wyznaczenia trasy czy kliknięcia w Twoją stronę nie płacisz Google ani grosza prowizji.
              </p>
            </div>

            <!-- Organic Value Telemetry Widget -->
            <div class="space-y-3 pt-2 border-t border-zinc-900">
              <div class="flex items-baseline justify-between">
                <div>
                  <div class="text-4xl font-extrabold text-[#ccff00] tabular-nums tracking-tight">0 zł</div>
                  <div class="text-xs text-zinc-400 font-medium mt-0.5">Kosztu za pojedyncze kliknięcie</div>
                </div>
                <div class="text-right">
                  <div class="text-xl font-bold text-white tabular-nums">100%</div>
                  <div class="text-xs text-zinc-400 font-medium mt-0.5">Darmowy ruch organiczny</div>
                </div>
              </div>
              <div class="p-3.5 rounded-xl bg-zinc-900/90 border border-zinc-800/80 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2 text-zinc-300">
                  <span class="w-2 h-2 rounded-full bg-[#ccff00] animate-pulse"></span>
                  <span>Widoczność w Mapach Google</span>
                </div>
                <span class="font-bold text-[#ccff00]">Stały dopływ</span>
              </div>
            </div>
          </div>

          <!-- Card 3 (Span 5, Warm Alabaster #f4f3f0): Kategoria główna i atrybuty -->
          <div class="md:col-span-5 p-8 sm:p-10 rounded-3xl bg-[#f4f3f0] border border-zinc-200 shadow-xs flex flex-col justify-between space-y-6 hover:border-zinc-300 transition-all card-hover-depth reveal-on-scroll delay-100">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-white text-zinc-950 border border-zinc-200 flex items-center justify-center shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold text-zinc-950 tracking-tight">
                Precyzyjna kategoria główna i atrybuty
              </h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Kategoria główna to pojedynczy najważniejszy czynnik rankingowy w algorytmie Map. Błędny wybór paraliżuje pozycję. Dobieram właściwe kategorie, konfiguruję kody pocztowe oraz ukryte atrybuty ułatwiające dopasowanie do zapytań.
              </p>
            </div>

            <!-- Ranking Factors Checklist Widget -->
            <div class="space-y-2.5">
              <div class="p-3 rounded-xl bg-white border border-zinc-200 text-xs flex items-center justify-between">
                <span class="font-bold text-zinc-800">Kategoria główna:</span>
                <span class="text-emerald-700 font-extrabold flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 100% dopasowana
                </span>
              </div>
              <div class="p-3 rounded-xl bg-white border border-zinc-200 text-xs flex items-center justify-between">
                <span class="font-bold text-zinc-800">Obszar działania (SAB):</span>
                <span class="text-zinc-600 font-semibold">Promień bez adresu domowego</span>
              </div>
              <div class="p-3 rounded-xl bg-white border border-zinc-200 text-xs flex items-center justify-between">
                <span class="font-bold text-zinc-800">Spójność danych NAP:</span>
                <span class="text-emerald-700 font-extrabold flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Zweryfikowana w sieci
                </span>
              </div>
            </div>
          </div>

          <!-- Card 4 (Span 7, Light #ffffff): Ochrona i zarządzanie opiniami -->
          <div class="md:col-span-7 p-8 sm:p-10 rounded-3xl bg-white border border-zinc-200 shadow-xs flex flex-col justify-between space-y-6 hover:border-zinc-300 transition-all card-hover-depth reveal-on-scroll delay-200">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-[#ccff00] text-zinc-950 flex items-center justify-center shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold text-zinc-950 tracking-tight">
                Ochrona przed konkurencją i system recenzji
              </h3>
              <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
                Zabezpieczam profil przed fałszywymi zgłoszeniami „firma zamknięta na stałe”, podmianami numeru telefonu czy próbami przejęcia wizytówki. Wdrażam też procedurę usuwania nieuczciwych opinii naruszających regulamin Google.
              </p>
            </div>

            <!-- Security & Defense Widget -->
            <div class="p-5 rounded-2xl bg-[#fcfbfa] border border-zinc-200 space-y-3 font-sans">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="p-3.5 rounded-xl bg-white border border-zinc-200">
                  <div class="text-xs font-bold text-zinc-950 flex items-center gap-1.5 mb-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Ochrona danych teleadresowych</span>
                  </div>
                  <div class="text-[11px] text-zinc-500">Blokada zewnętrznych edycji numeru i godzin otwarcia</div>
                </div>

                <div class="p-3.5 rounded-xl bg-white border border-zinc-200">
                  <div class="text-xs font-bold text-zinc-950 flex items-center gap-1.5 mb-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Odwołania od złośliwych opinii</span>
                  </div>
                  <div class="text-[11px] text-zinc-500">Zgłaszanie naruszeń regulaminu do supportu Google</div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Supporting Value Highlights Strip -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-zinc-200">
          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2H-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <div>
              <h4 class="font-extrabold text-zinc-950 text-base mb-1">Cotygodniowe posty ofertowe</h4>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">Algorytm faworyzuje profile, które wykazują stałą aktywność, publikując aktualności i prezentując ofertę.</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h4 class="font-extrabold text-zinc-950 text-base mb-1">Optymalizacja zdjęć realizacji</h4>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">Realne zdjęcia wykonanych prac ze zoptymalizowanymi metadanymi lokalizacji budują autorytet w oczach klientów.</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
            </div>
            <div>
              <h4 class="font-extrabold text-zinc-950 text-base mb-1">100% własności profilu</h4>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">Profil zawsze należy w całości do Ciebie jako Głównego Właściciela. Pełna niezależność i bezpieczeństwo danych.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3-Step Process: Connected Timeline -->
    <section class="py-20 md:py-28 bg-[#f4f3f0] border-b border-[#e7e5e4]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 reveal-on-scroll">
          <span class="text-xs font-extrabold uppercase tracking-wider text-zinc-400">Przejrzysta Procedura</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight mt-1 mb-4">
            Jak krok po kroku wyprowadzamy profil do Top 3?
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 max-w-2xl mx-auto">
            Pozycjonowanie w Mapach Google to sprawdzony proces: od audytu lokalnych konkurentów, przez techniczną konfigurację, po systematyczne budowanie autorytetu.
          </p>
        </div>

        <!-- Connected Timeline Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
          <!-- Step 1 -->
          <div class="p-8 sm:p-9 rounded-3xl bg-white border border-zinc-200 shadow-sm flex flex-col justify-between space-y-5 process-step-card reveal-on-scroll delay-100">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
              <span class="w-9 h-9 rounded-full bg-zinc-950 text-white flex items-center justify-center text-sm font-extrabold">1</span>
              <span class="text-xs font-bold text-zinc-500">Dzień 1–2</span>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950 tracking-tight mb-2">Głęboki audyt i analiza konkurencji</h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Badam widoczność Twojej firmy na mapie miasta w promieniu do 30 km. Analizuję kategorie, liczbę recenzji i słowa kluczowe 3 czołowych konkurentów, aby wskazać luki do ich wyprzedzenia.
              </p>
            </div>
            <div class="text-xs font-bold text-zinc-400 tabular-nums">KROK 01</div>
          </div>

          <!-- Step 2 -->
          <div class="p-8 sm:p-9 rounded-3xl bg-white border border-zinc-200 shadow-sm flex flex-col justify-between space-y-5 process-step-card reveal-on-scroll delay-200">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
              <span class="w-9 h-9 rounded-full bg-zinc-950 text-white flex items-center justify-center text-sm font-extrabold">2</span>
              <span class="text-xs font-bold text-zinc-500">Dzień 3–5</span>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950 tracking-tight mb-2">Optymalizacja techniczna i zabezpieczenie</h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Koryguję kategorię główną, uzupełniam pełen katalog usług z cenami, ustawiam precyzyjny obszar działania (SAB) oraz zabezpieczam profil przed próbami nieautoryzowanych edycji.
              </p>
            </div>
            <div class="text-xs font-bold text-zinc-400 tabular-nums">KROK 02</div>
          </div>

          <!-- Step 3 -->
          <div class="p-8 sm:p-9 rounded-3xl bg-white border border-zinc-200 shadow-sm flex flex-col justify-between space-y-5 process-step-card reveal-on-scroll delay-300">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
              <span class="w-9 h-9 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center text-sm font-extrabold">3</span>
              <span class="text-xs font-bold text-zinc-700">Kolejne 4–8 tygodni</span>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950 tracking-tight mb-2">Budowanie autorytetu i marsz do Top 3</h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Wdrażamy proces stałego pozyskiwania opinii od zadowolonych klientów i publikujemy regularne wpisy ofertowe. Algorytm rejestruje rosnącą aktywność, co systematycznie wynosi wizytówkę w górę rankingu.
              </p>
            </div>
            <div class="text-xs font-bold text-zinc-950 tabular-nums">KROK 03</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Specific FAQ: Semantic Accordion -->
    <section class="py-20 md:py-28 bg-white border-b border-[#e7e5e4]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <span class="text-xs font-extrabold uppercase tracking-wider text-zinc-400">Transparentne Zasady</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight mt-1 mb-4">
            Pytania i odpowiedzi o Mapy Google
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 leading-relaxed">
            Wszystko, co musisz wiedzieć o pozycjonowaniu wizytówki, opłatach i budowaniu widoczności w Twoim mieście.
          </p>
        </div>

        <!-- FAQ Accordion List using semantic details/summary -->
        <div class="space-y-4">
          {[
            {
              q: "Czy sam Profil Firmy w Google jest płatny?",
              a: "Utworzenie i posiadanie Profilu Firmy w Google jest w 100% darmowe – samo Google nie pobiera za to żadnego abonamentu. Płacisz wyłącznie za moją wiedzę i pracę: profesjonalny audyt, pełną optymalizację techniczną, zabezpieczenie profilu przed konkurencją i skuteczne pozycjonowanie go w pierwszej trójce wyników."
            },
            {
              q: "Ile czasu zajmuje wypozycjonowanie firmy do pierwszej trójki (Local 3-Pack)?",
              a: "Pierwsze efekty w postaci większej liczby wyświetleń i telefonów widać zazwyczaj w ciągu 2–4 tygodni od wprowadzenia optymalizacji. W konkurencyjnych branżach i większych miastach wejście do ścisłego Top 3 wymaga 1–3 miesięcy systematycznego zdobywania opinii i aktywności profilu. Mówię o tym wprost – algorytm organiczny wymaga konsekwencji, ale raz wypracowana pozycja przynosi bezpłatne zlecenia przez lata."
            },
            {
              q: "Czy muszę ujawniać prywatny adres domowy, jeśli dojeżdżam do klienta?",
              a: "Nie. Jeśli prowadzisz działalność mobilną (np. hydraulik, mobilny serwis, usługi remontowe czy pomoc drogowa), konfigurujemy profil jako SAB (Service Area Business – firma obsługująca określony obszar). Twój prywatny adres domowy jest całkowicie ukryty przed klientami, a na mapie wyświetla się jedynie promień działania lub lista obsługiwanych dzielnic i miast."
            },
            {
              q: "Co decyduje o tym, które 3 firmy Google wyświetla na szczycie mapy?",
              a: "Algorytm lokalny Google opiera się na 3 kluczowych filarach: Trafność (Relevance) – jak dokładnie kategoria i usługi odpowiadają zapytaniu klienta; Odległość (Distance) – jak blisko wyszukującego znajduje się Twoja firma lub obszar działania; oraz Rozpoznawalność i Autorytet (Prominence) – średnia ocen, liczba i częstotliwość recenzji, spójność danych kontaktowych (NAP) w sieci oraz stała aktywność wizytówki."
            },
            {
              q: "Co zrobić z fałszywą lub złośliwą opinią od konkurencji?",
              a: "Każda recenzja naruszająca regulamin Google (np. konflikt interesów, spam, brak faktycznego skorzystania z usługi, wulgaryzmy czy próby szantażu) kwalifikuje się do usunięcia. Składam w Twoim imieniu oficjalne odwołanie do zespołu wsparcia Google z precyzyjną argumentacją regulaminową. Równocześnie przygotowujemy opanowaną, profesjonalną odpowiedź na profilu, która w oczach klientów neutralizuje negatywne wrażenie."
            },
            {
              q: "Czy po jednorazowej optymalizacji wizytówka utrzyma pozycję na zawsze?",
              a: "Jednorazowa optymalizacja eliminuje błędy blokujące wyświetlanie i daje potężny impuls rankingowy, ale rynek lokalny żyje – konkurencja również podejmuje działania. Aby utrzymać pozycję w ścisłym Top 3 na długie miesiące, kluczowe jest stałe, naturalne dopisywanie nowych recenzji przez zadowolonych klientów oraz okresowe dodawanie świeżych zdjęć z realizacji."
            }
          ].map((faq, index) => (
            <details class="group rounded-2xl border border-zinc-200 bg-white p-6 transition-all duration-200 hover:border-zinc-400 [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-bold text-lg sm:text-xl text-zinc-950 select-none">
                <span class="flex items-center gap-3">
                  <span class="text-xs text-zinc-400 font-semibold tabular-nums">0{index + 1}.</span>
                  <span>{faq.q}</span>
                </span>
                <span class="w-8 h-8 rounded-full bg-zinc-100 text-zinc-700 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform group-hover:bg-[#ccff00] group-hover:text-zinc-950">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-zinc-100 text-zinc-600 text-base leading-relaxed pl-7">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CallToAction />
  </main>

  <MobileCallButton />
  <Footer />
