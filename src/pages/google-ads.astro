---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallButton from "../components/MobileCallButton.astro";
import CallToAction from "../components/CallToAction.astro";
import ServiceHeroArch from "../components/ServiceHeroArch.astro";
import { siteConfig } from "../data/siteConfig";
---

<Layout
  title="Kampanie Google Ads dla Lokalnych Firm | Kamil Pitner"
  description="Prowadzę skuteczne kampanie Google Ads dla lokalnych usługodawców. 100% budżetu na kliknięcia, zero prowizji od wydatków, precyzyjna kalibracja fraz."
>
  <Header />

  <main>
    <!-- Subpage Hero -->
    <section class="py-16 md:py-24 bg-[#e0f2fe]/50 border-b border-[#cbe4f9] relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-zinc-950 transition-colors">Strona główna</a>
          <span>/</span>
          <a href="/#uslugi" class="hover:text-zinc-950 transition-colors">Usługi</a>
          <span>/</span>
          <span class="text-zinc-900">Google Ads</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-950 tracking-tight leading-[1.12]">
              Dochodowe kampanie Google Ads dla lokalnych firm.
            </h1>

            <p class="text-lg sm:text-xl text-zinc-700 font-normal leading-relaxed">
              Trafiaj prosto do osób, które w tej chwili szukają Twoich usług w wyszukiwarce. Płacisz za realne zlecenia i telefony, a nie za puste wyświetlenia.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
              <a
                href={`tel:${siteConfig.phoneRaw}`}
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-zinc-950 text-white text-base font-extrabold shadow-xl hover:bg-zinc-800 transition-all border border-zinc-900 btn-tactile"
              >
                <span>Porozmawiajmy o kampanii</span>
              </a>
              <a
                href="/"
                class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-2xl bg-white text-zinc-800 text-base font-bold hover:bg-zinc-100 border border-zinc-300 transition-all"
              >
                <span>← Wróć do strony głównej</span>
              </a>
            </div>
          </div>

          <!-- Hero Graphic Right (Span 5): 3D Service Arch Card (Google Ads) -->
          <div class="lg:col-span-5 reveal-on-scroll delay-100 flex items-center justify-center">
            <ServiceHeroArch serviceId="google-ads" />
          </div>

        </div>

      </div>
    </section>

    <!-- Value Grid: Asymmetric Bento Grid -->
    <section class="py-20 md:py-28 bg-[#fcfbfa] border-b border-[#e7e5e4]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16 reveal-on-scroll">
          <span class="text-xs font-extrabold uppercase tracking-wider text-zinc-400">Kluczowe Przewagi</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight mt-1 mb-4">
            Dlaczego kampanie Google Ads są bezkonkurencyjne?
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 leading-relaxed">
            W odróżnieniu od mediów społecznościowych, w wyszukiwarce nie narzucasz się przypadkowym osobom – trafiasz prosto do klientów, którzy mają pilną potrzebę i w tej chwili szukają wykonawcy.
          </p>
        </div>

        <!-- Asymmetric Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

          <!-- Card 1 (Span 7, Light #ffffff): 100% budżetu do Google bez prowizji od wydatków -->
          <div class="md:col-span-7 p-8 sm:p-10 rounded-3xl bg-white border border-zinc-200 shadow-xs flex flex-col justify-center hover:border-zinc-300 transition-all card-hover-depth reveal-on-scroll delay-100">
            <div class="space-y-4">
              <div class="w-10 h-10 rounded-xl bg-zinc-950 text-[#ccff00] flex items-center justify-center shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold text-zinc-950 tracking-tight">
                100% budżetu trafia do Google – zero ukrytej prowizji
              </h3>
              <p class="text-base text-zinc-600 leading-relaxed max-w-xl">
                Tradycyjne agencje pobierają 15–25% prowizji od wielkości Twojego budżetu na media, co zachęca je do sztucznego pompowania kosztów. U mnie rozliczasz się na stałych, przejrzystych warunkach. Cały budżet reklamowy pracuje bezpośrednio na pozyskanie zapytań.
              </p>
            </div>
          </div>

          <!-- Card 2 (Span 5, Dark Contrast #09090b / #0c0d12): Śledzenie realnych telefonów -->
          <div class="md:col-span-5 p-8 sm:p-10 rounded-3xl bg-zinc-950 text-white shadow-xl flex flex-col justify-between space-y-6 card-hover-depth-dark reveal-on-scroll delay-200">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 text-[#ccff00] flex items-center justify-center shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold tracking-tight text-white">
                Mierzysz realne telefony, a nie puste wyświetlenia
              </h3>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Koniec z wielostronicowymi raportami pełnymi „zasięgów”, z których nic nie wynika dla Twojego portfela. Konfiguruję śledzenie faktycznych połączeń i formularzy – wiesz dokładnie, ile osób zadzwoniło i jaki był realny koszt zlecenia.
              </p>
            </div>

            <!-- Conversion & Telemetry Widget -->
            <div class="space-y-3 pt-2 border-t border-zinc-900">
              <div class="flex items-baseline justify-between">
                <div>
                  <div class="text-4xl font-extrabold text-[#ccff00] tabular-nums tracking-tight">100%</div>
                  <div class="text-xs text-zinc-400 font-medium mt-0.5">Mierzalnych telefonów i zapytań</div>
                </div>
                <div class="text-right">
                  <div class="text-xl font-bold text-white tabular-nums">0 zł</div>
                  <div class="text-xs text-zinc-400 font-medium mt-0.5">Za puste wyświetlenia</div>
                </div>
              </div>
              <div class="p-3.5 rounded-xl bg-zinc-900/90 border border-zinc-800/80 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2 text-zinc-300">
                  <span class="w-2 h-2 rounded-full bg-[#ccff00] animate-pulse"></span>
                  <span>Rejestr połączeń Google Ads</span>
                </div>
                <span class="font-bold text-[#ccff00]">Aktywne</span>
              </div>
            </div>
          </div>

          <!-- Card 3 (Span 5, Warm Alabaster #f4f3f0): Odcinanie pustych fraz i słów wykluczających -->
          <div class="md:col-span-5 p-8 sm:p-10 rounded-3xl bg-[#f4f3f0] border border-zinc-200 shadow-xs flex flex-col justify-between space-y-6 hover:border-zinc-300 transition-all card-hover-depth reveal-on-scroll delay-100">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-white text-zinc-950 border border-zinc-200 flex items-center justify-center shadow-2xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold text-zinc-950 tracking-tight">
                Odcinanie pustych fraz i słów wykluczających
              </h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Nie płacisz za kliknięcia osób szukających darmowych porad czy instrukcji zrób-to-sam. Blokuję setki fraz wykluczających, aby budżet trafiał wyłącznie na klientów gotowych do zamówienia usługi.
              </p>
            </div>

            <!-- Negative Keywords Tags Widget -->
            <div class="space-y-3">
              <div class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Zablokowane zapytania (0 zł kosztu):</div>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-rose-200 text-rose-700 text-xs font-bold shadow-2xs">
                  <span class="text-rose-500 font-extrabold text-xs">✕</span> za darmo
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-rose-200 text-rose-700 text-xs font-bold shadow-2xs">
                  <span class="text-rose-500 font-extrabold text-xs">✕</span> jak zrobić samemu
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-rose-200 text-rose-700 text-xs font-bold shadow-2xs">
                  <span class="text-rose-500 font-extrabold text-xs">✕</span> pdf
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-rose-200 text-rose-700 text-xs font-bold shadow-2xs">
                  <span class="text-rose-500 font-extrabold text-xs">✕</span> cennik konkurencji
                </span>
              </div>
              <div class="p-3 rounded-xl bg-white border border-zinc-200 text-xs font-bold text-zinc-700 flex items-center justify-between">
                <span>Oszczędność budżetu:</span>
                <span class="text-emerald-700 font-extrabold">do 40% mniej przepaleń</span>
              </div>
            </div>
          </div>

          <!-- Card 4 (Span 7, Light #ffffff): Reklamy lokalne z bezpośrednim rozszerzeniem połączeń -->
          <div class="md:col-span-7 p-8 sm:p-10 rounded-3xl bg-white border border-zinc-200 shadow-xs flex flex-col justify-between space-y-6 hover:border-zinc-300 transition-all card-hover-depth reveal-on-scroll delay-200">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-[#ccff00] text-zinc-950 flex items-center justify-center shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-extrabold text-zinc-950 tracking-tight">
                Reklamy lokalne z bezpośrednim rozszerzeniem połączeń
              </h3>
              <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
                Precyzyjnie określamy promień kilometrów wokół Twojej bazy (np. 15–30 km) lub konkretne dzielnice. Dodaję klikalny numer telefonu bezpośrednio w wynikach wyszukiwania – klient dzwoni do Ciebie 1 dotknięciem kciuka bez konieczności wchodzenia na stronę.
              </p>
            </div>

            <!-- Visual Google Search Ad Mockup with Call Extension -->
            <div class="p-5 rounded-2xl bg-[#fcfbfa] border border-zinc-200 space-y-3 font-sans">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-[11px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-zinc-200 text-zinc-700">Sponsorowane</span>
                  <span class="text-xs text-zinc-500 font-medium">twoja-firma.pl/uslugi-lokalne</span>
                </div>
                <span class="text-xs font-bold text-emerald-700 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Promień: Twoje miasto +25 km
                </span>
              </div>
              <div class="text-base font-bold text-blue-700 hover:underline cursor-pointer">
                Pogotowie Usługowe – Szybki Dojazd i Wycena | Wolne Terminy Dziś
              </div>
              <p class="text-xs text-zinc-600 leading-relaxed">
                Specjalistyczne usługi na terenie Twojego miasta. Doświadczenie, legalne faktury i gwarancja. Zadzwoń i zamów wizytę w 15 minut.
              </p>
              <div class="pt-2 border-t border-zinc-200/80 flex flex-wrap items-center gap-3">
                <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-zinc-950 text-white text-xs font-bold shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#ccff00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Połącz bezpośrednio z reklamą</span>
                </div>
                <span class="text-xs font-semibold text-zinc-500">Kliknięcie natychmiast łączy z Twoim telefonem</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Supporting Value Highlights Strip -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-zinc-200">
          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <h4 class="font-extrabold text-zinc-950 text-base mb-1">Bieżąca optymalizacja CPC</h4>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">Cotygodniowa weryfikacja stawek i testy tekstów reklamowych w celu stałego obniżania kosztu za pojedynczego klienta.</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <h4 class="font-extrabold text-zinc-950 text-base mb-1">Pełna własność konta Ads</h4>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">Kampania jest konfigurowana na Twoim własnym koncie Google – jesteś 100% właścicielem danych, historii i kampanii.</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-zinc-200 shadow-xs flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div>
              <h4 class="font-extrabold text-zinc-950 text-base mb-1">Raporty bez marketingowego żargonu</h4>
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">Zamiast zawiłych tabelek dostajesz czytelne podsumowanie: ile wydano w Google, ile osób zadzwoniło i jaki był koszt pozyskania zlecenia.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3-Step Process: Connected Timeline -->
    <section class="py-20 md:py-28 bg-[#f4f3f0] border-b border-[#e7e5e4]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 reveal-on-scroll">
          <span class="text-xs font-extrabold uppercase tracking-wider text-zinc-400">Prosty i Przejrzysty Proces</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-950 tracking-tight mt-1 mb-4">
            Jak budujemy rentowną kampanię?
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 max-w-2xl mx-auto">
            Bez obietnic o natychmiastowych cudach w 24 godziny. Kampania to proces: od starannej konfiguracji, przez kalibrację algorytmu i wycinanie nietrafionych fraz, po stabilny napływ zleceń.
          </p>
        </div>

        <!-- Connected Timeline Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
          <!-- Step 1 -->
          <div class="p-8 sm:p-9 rounded-3xl bg-white border border-zinc-200 shadow-sm flex flex-col justify-between space-y-5 process-step-card reveal-on-scroll delay-100">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
              <span class="w-9 h-9 rounded-full bg-zinc-950 text-white flex items-center justify-center text-sm font-extrabold">1</span>
              <span class="text-xs font-bold text-zinc-500">15 minut rozmowy</span>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950 tracking-tight mb-2">Wybór usług i budżetu</h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Ustalamy, które zlecenia przynoszą Twojej firmie najwyższy zysk, w jakim promieniu kilometrów działasz oraz jaki budżet testowy przeznaczamy na kliknięcia w Google.
              </p>
            </div>
            <div class="text-xs font-bold text-zinc-400 tabular-nums">KROK 01</div>
          </div>

          <!-- Step 2 -->
          <div class="p-8 sm:p-9 rounded-3xl bg-white border border-zinc-200 shadow-sm flex flex-col justify-between space-y-5 process-step-card reveal-on-scroll delay-200">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
              <span class="w-9 h-9 rounded-full bg-zinc-950 text-white flex items-center justify-center text-sm font-extrabold">2</span>
              <span class="text-xs font-bold text-zinc-500">2–3 dni robocze</span>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950 tracking-tight mb-2">Konfiguracja i wykluczenia</h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Przygotowuję teksty reklamowe pod lokalną specyfikę, dobieram słowa kluczowe o intencji zakupu i od razu wdrażam obszerną listę słów wykluczających. Konfiguruję też mierzenie połączeń telefonicznych.
              </p>
            </div>
            <div class="text-xs font-bold text-zinc-400 tabular-nums">KROK 02</div>
          </div>

          <!-- Step 3 -->
          <div class="p-8 sm:p-9 rounded-3xl bg-white border border-zinc-200 shadow-sm flex flex-col justify-between space-y-5 process-step-card reveal-on-scroll delay-300">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
              <span class="w-9 h-9 rounded-full bg-[#ccff00] text-zinc-950 flex items-center justify-center text-sm font-extrabold">3</span>
              <span class="text-xs font-bold text-zinc-700">Pierwsze 2–4 tygodnie</span>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950 tracking-tight mb-2">Faza nauki i kalibracja stawek</h3>
              <p class="text-sm text-zinc-600 leading-relaxed">
                Po starcie emisji algorytm Google Ads potrzebuje czasu i danych, by rozpoznać profil dzwoniących klientów. W tym czasie regularnie czyszczę raport zapytań i optymalizuję stawki, aż koszt pozyskania klienta się ustabilizuje.
              </p>
            </div>
            <div class="text-xs font-bold text-zinc-950 tabular-nums">KROK 03</div>
          </div>
