---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CallToAction from "../components/CallToAction.astro";
import MobileCallButton from "../components/MobileCallButton.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/siteConfig";

const posts = [
  {
    title: "Jak zdobyć 50+ opinii 5★ w Google bez proszenia i krępacji?",
    category: "Opinie Google",
    readTime: "4 min czytania",
    date: "Wrzesień 2024",
    excerpt: "Dlaczego tradycyjna prośba o recenzję nie działa i jak karty zbliżeniowe NFC skracają drogę klienta z 5 minut do 5 sekund.",
    tag: "NFC & Opinie"
  },
  {
    title: "Strona internetowa dla lokalnej firmy: co naprawdę przynosi telefony?",
    category: "Strony WWW",
    readTime: "5 min czytania",
    date: "Sierpień 2024",
    excerpt: "Analiza zachowań klientów mobilnych. Dlaczego 80% użytkowników dzwoni w pierwszych 10 sekundach i jak zaprojektować stronę, by nie gubić zapytań.",
    tag: "Konwersja"
  },
  {
    title: "Google Ads dla usług lokalnych: jak nie przepalić budżetu w pierwszy tydzień?",
    category: "Google Ads",
    readTime: "6 min czytania",
    date: "Lipiec 2024",
    excerpt: "Najczęstsze błędy początkujących przedsiębiorców w kampaniach Google Ads i zasada precyzyjnego targetowania na połączenia telefoniczne.",
    tag: "Płatne Kampanie"
  },
  {
    title: "Pozycjonowanie w Mapach Google: jak wejść do Top 3 w Twoim mieście?",
    category: "Google Moja Firma",
    readTime: "5 min czytania",
    date: "Czerwiec 2024",
    excerpt: "Kompletny przewodnik po optymalizacji profilu firmy: kategorie główne, zdjęcia, geolokalizacja i wpływ recenzji na pozycję w Mapach.",
    tag: "Lokalne SEO"
  }
];
---

<Layout
  title="Blog o marketingu lokalnym i pozyskiwaniu klientów | Kamil Pitner"
  description="Praktyczne poradniki i wskazówki jak zdobywać zlecenia z wyszukiwarki Google, tworzyć konwertujące strony WWW i zbierać opinie 5★."
>
  <Header />

  <main>
    <!-- Hero Header -->
    <section class="py-16 md:py-24 bg-[#fcfbfa] border-b border-[#e7e5e4]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-zinc-950 transition-colors">Strona główna</a>
          <span>/</span>
          <span class="text-zinc-900">Blog</span>
        </nav>

        <div class="max-w-3xl space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-950 text-[#ccff00] text-xs font-bold uppercase tracking-wider">
            <span>Baza Wiedzy & Poradniki</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-950 tracking-tight leading-[1.12]">
            Praktyczna wiedza o pozyskiwaniu klientów lokalnych.
          </h1>

          <p class="text-lg sm:text-xl text-zinc-600 font-normal leading-relaxed">
            Bez teorii i lania wody. Konkretne strategie, które stosuję u moich klientów: strony WWW, Google Ads, wizytówki w Mapach oraz systemy zbierania opinii.
          </p>
        </div>

      </div>
    </section>

    <!-- Articles Grid -->
    <section class="py-20 bg-white border-b border-[#e7e5e4]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {posts.map((post) => (
            <article class="p-8 sm:p-10 rounded-3xl bg-[#fcfbfa] border border-[#e7e5e4] shadow-xs flex flex-col justify-between hover:border-zinc-300 hover:shadow-md transition-all group">
              <div>
                <div class="flex items-center justify-between gap-4 mb-5 text-xs text-zinc-500 font-semibold">
                  <span class="px-3 py-1 rounded-full bg-zinc-100 text-zinc-800">{post.category}</span>
                  <span>{post.readTime}</span>
                </div>

                <h2 class="text-2xl font-extrabold text-zinc-950 tracking-tight mb-3 group-hover:text-zinc-700 transition-colors leading-snug">
                  {post.title}
                </h2>

                <p class="text-sm sm:text-base text-zinc-600 leading-relaxed mb-6">
                  {post.excerpt}
                </p>
              </div>

              <div class="pt-6 border-t border-zinc-200/80 flex items-center justify-between text-xs">
                <span class="text-zinc-400">{post.date}</span>
                <span class="font-bold text-zinc-900 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  <span>Wkrótce pełny artykuł</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <CallToAction />
  </main>

  <MobileCallButton />
  <Footer />
</Layout>
